<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mateo.freetpv.controller.LoginController">
   <top>
      <ImageView fitHeight="400.0" fitWidth="400.0" pickOnBounds="true" preserveRatio="true" BorderPane.alignment="CENTER">
         <image>
            <Image url="@../images/freetpv_logo.png" />
         </image>
      </ImageView>
   </top>
   <center>
      <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="50.0" spacing="30.0" BorderPane.alignment="CENTER">
         <children>
            <ComboBox fx:id="usuarioComboBox" maxWidth="150.0" prefWidth="150.0" promptText="Usuario" />
            <PasswordField fx:id="pinField" alignment="CENTER" maxWidth="100.0" prefWidth="100.0" promptText="PIN" />
            <Button fx:id="loginButton" maxWidth="150.0" mnemonicParsing="false" onAction="#handleLogin" text="Iniciar sesión" />
            <Label fx:id="errorLabel" visible="false" />
         </children>
      </VBox>
   </center>
   <bottom>
      <Label text="FREETPV 1.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="20.0" />
         </BorderPane.margin>
      </Label>
   </bottom>
</BorderPane>
