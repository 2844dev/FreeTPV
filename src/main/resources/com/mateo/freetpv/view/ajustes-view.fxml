                  <FontIcon iconLiteral="fas-save" iconSize="16" />
               </graphic></Button>
         </bottom>
         <center>
            <ScrollPane fitToWidth="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" BorderPane.alignment="CENTER">
               <content>
                  <VBox>
                     <children>
                        <Label text="Empresa">
                           <font>
                              <Font size="18.0" />
                           </font>
                           <styleClass>
                              <String fx:value="text-bold" />
                              <String fx:value="accent" />
                           </styleClass>
                        </Label>
                        <Tile fx:id="nombreEmpresaTile" description="Nombre comercial que aparecerá en la parte superior del ticket." title="Nombre de la empresa" />
                        <Tile fx:id="cifEmpresaTile" description="Identificador fiscal del negocio. Se mostrará en el ticket si la opción está activada." title="CIF/NIF" />
                        <Tile fx:id="direccionEmpresaTile" description="Dirección física del negocio que aparecerá en el ticket." title="Dirección" />
                        <Tile fx:id="codigoPostalEmpresaTile" description="Código postal de la dirección del negocio." title="Código postal" />
                        <Tile fx:id="ciudadEmpresaTile" description="Ciudad o localidad del negocio." title="Ciudad" />
                        <Tile fx:id="telefonoEmpresaTile" description="Teléfono de contacto que aparecerá en el ticket si la opción está activada." title="Teléfono" />
                        <Tile fx:id="webEmpresaTile" description="Página web o enlace del negocio. Se mostrará al final del ticket si la opción está activada." title="Web" />
                        <Tile fx:id="qrEmpresaTile" description="URL para imprimir en ticket" title="QR" />
                        <Separator prefWidth="200.0" />
                        <Label text="Ticket">
                           <font>
                              <Font size="18.0" />
                           </font>
                           <styleClass>
                              <String fx:value="text-bold" />
                              <String fx:value="accent" />
                           </styleClass>
                        </Label>
                        <Tile fx:id="tituloTicketTile" description="Texto principal del ticket. Por defecto: “TICKET DE VENTA”." title="Título del ticket" />
