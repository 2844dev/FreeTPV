                        <Tile fx:id="mostrarCifTicketTile" description="Muestra u oculta el CIF/NIF de la empresa en el ticket." title="Mostrar CIF/NIF" />
                        <Tile fx:id="mostrarTelefonoTicketTile" description="Muestra u oculta el teléfono de contacto en el ticket." title="Mostrar teléfono" />
                        <Tile fx:id="mostrarWebTicketTile" description="Muestra u oculta la web del negocio al final del ticket." title="Mostrar web" />
                        <Tile fx:id="mostrarIvaTicketTile" description="Muestra u oculta el resumen de impuestos en el ticket." title="Mostrar desglose de IVA" />
                        <Tile fx:id="mostrarQrTicketTile" description="" title="Mostrar QR" />
                        <Separator prefWidth="200.0" />
                        <Label text="Impresora">
                           <font>
                              <Font size="18.0" />
                           </font>
