<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mateo.freetpv.controller.MainController">
   <left>
      <VBox alignment="TOP_CENTER" maxWidth="250.0" prefWidth="250.0" spacing="30.0" style="-fx-background-color: #e6d7fc;" BorderPane.alignment="CENTER">
         <children>
            <ImageView fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/freetpv_logo.png" />
               </image>
            </ImageView>
            <Button fx:id="ventasButton" mnemonicParsing="false" onAction="#mostrarVentas" prefHeight="70.0" prefWidth="250.0" text="Pantalla de ventas" />
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label prefWidth="250.0" text="GESTIÓN">
