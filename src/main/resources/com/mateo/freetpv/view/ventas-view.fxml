<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1">
   <center>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
         <children>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true">
               <content>
                  <TilePane hgap="20.0" prefTileHeight="128.0" prefTileWidth="128.0" tileAlignment="TOP_LEFT"
                            vgap="20.0"/>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </center>
   <top>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <Button contentDisplay="TOP" graphicTextGap="2.0" mnemonicParsing="false" prefHeight="75.0" prefWidth="75.0"
                    text="Salir">
               <graphic>
                  <FontIcon iconLiteral="fas-angle-double-right" iconSize="16"/>
               </graphic>
            </Button>
         </children>
      </HBox>
   </top>
</BorderPane>
